generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum PostStatus {
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  SOLD
  BUILDING
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String
  role         UserRole  @default(ADMIN)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id            String   @id
  userId        Int
  csrfTokenHash String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Post {
  id              Int        @id @default(autoincrement())
  title           String     @db.VarChar(200)
  summary         String     @db.VarChar(500)
  contentMarkdown String
  coverImageUrl   String?    @db.VarChar(2048)
  status          PostStatus @default(PUBLISHED)
  seoTitle        String?    @db.VarChar(200)
  seoDescription  String?    @db.VarChar(500)
  publishedAt     DateTime   @default(now())
  viewCount       Int        @default(0)
  tags            PostTag[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([updatedAt])
  @@index([viewCount])
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(50)
  slug      String    @unique @db.VarChar(60)
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId, postId])
}

model Project {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(100)
  summary    String        @db.VarChar(500)
  status     ProjectStatus @default(ACTIVE)
  websiteUrl String?       @db.VarChar(2048)
  githubUrl  String?       @db.VarChar(2048)
  techStack  String[]      @default([])
  sort       Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, sort])
}

model SiteSetting {
  id        Int      @id @default(1)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteStats {
  id         Int      @id @default(1)
  totalViews Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BookmarkCategory {
  id        Int                @id @default(autoincrement())
  name      String             @db.VarChar(50)
  parentId  Int?
  parent    BookmarkCategory?  @relation("BookmarkCategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children  BookmarkCategory[] @relation("BookmarkCategoryParent")
  sort      Int                @default(0)
  bookmarks Bookmark[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([parentId, name])
  @@index([parentId, sort])
  @@index([sort, id])
}

model Bookmark {
  id          Int              @id @default(autoincrement())
  categoryId  Int
  category    BookmarkCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String           @db.VarChar(100)
  description String           @db.VarChar(500)
  iconUrl     String?          @db.VarChar(2048)
  url         String           @unique @db.VarChar(2048)
  sort        Int              @default(0)
  isVisible   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, sort])
  @@index([isVisible, sort])
}
